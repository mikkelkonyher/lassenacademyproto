meta {
  name: Contact - Missing Fields
  type: http
  seq: 1
}

post {
  url: {{supabase_url}}/functions/v1/send-contact-message
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  apikey: {{supabase_anon_key}}
}

body:json {
  {
    "name": "Test User",
    "email": "test@example.com",
    "subject": "Hello"
  }
}

assert {
  res.status: eq 400
  res.body.code: eq INVALID_INPUT
}

docs {
  Message field is missing, so the function rejects with INVALID_INPUT.
  No email is sent. Public endpoint — only the apikey header is required.
}
