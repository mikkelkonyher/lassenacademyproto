meta {
  name: Verify Login Fails After Deletion
  type: http
  seq: 3
}

post {
  url: {{supabase_url}}/auth/v1/token?grant_type=password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  apikey: {{supabase_anon_key}}
}

body:json {
  {
    "email": "{{disposable_email}}",
    "password": "{{disposable_password}}"
  }
}

assert {
  res.status: eq 400
}

script:post-response {
  // The account is gone, so credentials must no longer be valid.
  if (res.status === 200) {
    throw new Error("Login still succeeds after deletion — the account was not removed.");
  }
}
