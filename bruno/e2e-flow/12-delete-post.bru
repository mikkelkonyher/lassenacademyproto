meta {
  name: Delete Forum Post
  type: http
  seq: 12
}

post {
  url: {{supabase_url}}/functions/v1/delete-forum-post
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{auth_token}}
  apikey: {{supabase_anon_key}}
}

body:json {
  {
    "post_id": "{{test_post_id}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
