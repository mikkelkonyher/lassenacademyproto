meta {
  name: GET - Verify Post Deleted
  type: http
  seq: 13
}

get {
  url: {{supabase_url}}/rest/v1/forum_posts?id=eq.{{test_post_id}}&select=id
  body: none
  auth: none
}

headers {
  apikey: {{supabase_anon_key}}
  Authorization: Bearer {{auth_token}}
}

assert {
  res.status: eq 200
  res.body: length 0
}
