meta {
  name: Update News Article
  type: http
  seq: 16
}

post {
  url: {{supabase_url}}/functions/v1/update-news
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{auth_token}}
  apikey: {{supabase_anon_key}}
}

body:json {
  {
    "id": "{{test_news_id}}",
    "title_da": "E2E Test Nyhed - Opdateret af Bruno",
    "title_en": "E2E Test News - Updated by Bruno",
    "body_da": "Denne nyhed er blevet opdateret af Bruno E2E testen.",
    "body_en": "This news article has been updated by the Bruno E2E test.",
    "published": false
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.article.title_da: eq E2E Test Nyhed - Opdateret af Bruno
  res.body.article.published: eq false
}
