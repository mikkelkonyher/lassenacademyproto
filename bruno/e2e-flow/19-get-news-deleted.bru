meta {
  name: GET - Verify News Deleted
  type: http
  seq: 19
}

get {
  url: {{supabase_url}}/rest/v1/news?id=eq.{{test_news_id}}&select=id
  body: none
  auth: none
}

headers {
  apikey: {{supabase_anon_key}}
  Authorization: Bearer {{auth_token}}
}

assert {
  res.status: eq 200
  res.body: length 0
}
