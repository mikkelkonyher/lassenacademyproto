meta {
  name: Create Course Purchase
  type: http
  seq: 20
}

post {
  url: {{supabase_url}}/functions/v1/create-course-purchase
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{auth_token}}
  apikey: {{supabase_anon_key}}
}

body:json {
  {
    "course_id": "{{test_course_id}}"
  }
}

script:post-response {
  // Status is 201 on first run (new purchase) or 200 on subsequent runs
  // (idempotent return). Either is a successful test outcome.
  if (res.status !== 200 && res.status !== 201) {
    throw new Error(`Expected status 200 or 201, got ${res.status}: ${JSON.stringify(res.body)}`);
  }

  // Response shape: { purchase: { id, course_id, user_id, ... }, already_owned: boolean }
  if (!res.body.purchase || !res.body.purchase.id) {
    throw new Error(`Missing purchase in response body: ${JSON.stringify(res.body)}`);
  }

  if (typeof res.body.already_owned !== "boolean") {
    throw new Error(`already_owned should be boolean: ${JSON.stringify(res.body)}`);
  }

  // Save purchase id for the verify step (step 22 also re-checks the course_id
  // via assert, so we don't need to duplicate that comparison here — env vars
  // aren't readable via bru.getVar inside scripts anyway)
  bru.setVar("test_purchase_id", res.body.purchase.id);
}
