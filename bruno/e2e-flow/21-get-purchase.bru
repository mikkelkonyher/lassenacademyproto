meta {
  name: GET - Verify Purchase Created
  type: http
  seq: 21
}

get {
  url: {{supabase_url}}/rest/v1/user_course_purchases?id=eq.{{test_purchase_id}}&select=id,course_id,user_id,payment_provider,price_paid_dkk
  body: none
  auth: none
}

headers {
  apikey: {{supabase_anon_key}}
  Authorization: Bearer {{auth_token}}
}

assert {
  res.status: eq 200
  res.body: length 1
  res.body[0].course_id: eq {{test_course_id}}
  res.body[0].payment_provider: eq mock
}

script:post-response {
  // Verify user_id matches the logged-in user (RLS already guarantees this,
  // but the explicit check catches a misconfiguration that lets the wrong
  // user see another user's purchases)
  const userId = bru.getVar("user_id");
  if (res.body[0].user_id !== userId) {
    throw new Error(`user_id mismatch: expected ${userId}, got ${res.body[0].user_id}`);
  }

  // Price snapshot should be a positive number
  if (typeof res.body[0].price_paid_dkk !== "number" && typeof res.body[0].price_paid_dkk !== "string") {
    throw new Error(`price_paid_dkk should be numeric, got ${typeof res.body[0].price_paid_dkk}`);
  }
  if (Number(res.body[0].price_paid_dkk) <= 0) {
    throw new Error(`price_paid_dkk should be > 0, got ${res.body[0].price_paid_dkk}`);
  }
}
