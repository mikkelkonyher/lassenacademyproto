meta {
  name: Create Course Purchase - Idempotent
  type: http
  seq: 22
}

post {
  url: {{supabase_url}}/functions/v1/create-course-purchase
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{auth_token}}
  apikey: {{supabase_anon_key}}
}

body:json {
  {
    "course_id": "{{test_course_id}}"
  }
}

assert {
  res.status: eq 200
  res.body.already_owned: eq true
  res.body.purchase.course_id: eq {{test_course_id}}
}

script:post-response {
  // The purchase row returned MUST be the same one created/found in step 20 —
  // a duplicate insert would mean the unique constraint or idempotency check
  // is broken.
  const expected = bru.getVar("test_purchase_id");
  if (res.body.purchase.id !== expected) {
    throw new Error(`Expected purchase id ${expected}, got ${res.body.purchase.id}`);
  }
}
