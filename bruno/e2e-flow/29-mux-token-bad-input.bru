meta {
  name: Mux Token - Rejects malformed lesson_id
  type: http
  seq: 29
}

post {
  url: {{supabase_url}}/functions/v1/get-mux-token
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{auth_token}}
  apikey: {{supabase_anon_key}}
}

body:json {
  {
    "lesson_id": "not-a-uuid"
  }
}

assert {
  res.status: eq 400
  res.body.code: eq INVALID_INPUT
}
