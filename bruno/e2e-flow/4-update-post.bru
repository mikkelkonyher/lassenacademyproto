meta {
  name: Update Forum Post
  type: http
  seq: 4
}

post {
  url: {{supabase_url}}/functions/v1/update-forum-post
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{auth_token}}
  apikey: {{supabase_anon_key}}
}

body:json {
  {
    "post_id": "{{test_post_id}}",
    "title": "E2E Test Post - Updated by Bruno",
    "body": "This post has been updated by the Bruno E2E test. Verifying that update functionality works correctly.",
    "category": "guitar"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
