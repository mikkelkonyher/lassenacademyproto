meta {
  name: Course Material - Unknown course is 404
  type: http
  seq: 41
}

post {
  url: {{supabase_url}}/functions/v1/get-course-material
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{auth_token}}
  apikey: {{supabase_anon_key}}
}

body:json {
  {
    "course_id": "00000000-0000-0000-0000-000000000000"
  }
}

assert {
  res.status: eq 404
  res.body.code: eq NOT_FOUND
}

script:post-response {
  // A missing course, an unpublished one and one without a PDF all answer the
  // same 404 on purpose — the response must not tell a caller which of the
  // three it hit, nor let them probe for unpublished courses.
}
