meta {
  name: Update Forum Comment
  type: http
  seq: 8
}

post {
  url: {{supabase_url}}/functions/v1/update-forum-comment
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{auth_token}}
  apikey: {{supabase_anon_key}}
}

body:json {
  {
    "comment_id": "{{test_comment_id}}",
    "body": "This comment has been updated by the Bruno E2E test. Verifying that comment update works correctly."
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
