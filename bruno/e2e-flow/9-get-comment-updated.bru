meta {
  name: GET - Verify Comment Updated
  type: http
  seq: 9
}

get {
  url: {{supabase_url}}/rest/v1/forum_comments?id=eq.{{test_comment_id}}&select=id,body
  body: none
  auth: none
}

headers {
  apikey: {{supabase_anon_key}}
  Authorization: Bearer {{auth_token}}
}

assert {
  res.status: eq 200
  res.body[0].body: eq This comment has been updated by the Bruno E2E test. Verifying that comment update works correctly.
}
