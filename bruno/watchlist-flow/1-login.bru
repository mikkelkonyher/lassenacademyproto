meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{supabase_url}}/auth/v1/token?grant_type=password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  apikey: {{supabase_anon_key}}
}

body:json {
  {
    "email": "{{test_email}}",
    "password": "{{test_password}}"
  }
}

assert {
  res.status: eq 200
  res.body.access_token: isString
}

script:post-response {
  // Store the JWT and user_id for the rest of the flow
  bru.setVar("auth_token", res.body.access_token);
  bru.setVar("user_id", res.body.user.id);
}
