meta {
  name: GET - Verify Lesson Removed
  type: http
  seq: 11
}

get {
  url: {{supabase_url}}/rest/v1/user_watchlist?item_type=eq.lesson&lesson_id=eq.{{test_lesson_id}}&select=id
  body: none
  auth: none
}

headers {
  apikey: {{supabase_anon_key}}
  Authorization: Bearer {{auth_token}}
}

assert {
  res.status: eq 200
  res.body: isArray
}

script:post-response {
  if (res.body.length !== 0) {
    throw new Error(`expected empty array, got ${res.body.length} rows`);
  }
}
