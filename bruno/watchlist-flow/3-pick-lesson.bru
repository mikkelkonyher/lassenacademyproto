meta {
  name: Pick a Published Lesson
  type: http
  seq: 3
}

get {
  url: {{supabase_url}}/rest/v1/lessons?published=eq.true&select=id&limit=1
  body: none
  auth: none
}

headers {
  apikey: {{supabase_anon_key}}
}

assert {
  res.status: eq 200
  res.body: isArray
  res.body[0].id: isString
}

script:post-response {
  // Stash a real lesson id so the watchlist insert respects the FK
  bru.setVar("test_lesson_id", res.body[0].id);
}
