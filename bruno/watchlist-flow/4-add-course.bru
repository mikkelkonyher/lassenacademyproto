meta {
  name: Add Course to Watchlist
  type: http
  seq: 4
}

post {
  url: {{supabase_url}}/rest/v1/user_watchlist
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  apikey: {{supabase_anon_key}}
  Authorization: Bearer {{auth_token}}
  Prefer: return=representation
}

body:json {
  {
    "user_id": "{{user_id}}",
    "item_type": "course",
    "course_id": "{{test_course_id}}"
  }
}

assert {
  res.status: eq 201
  res.body[0].item_type: eq course
}
