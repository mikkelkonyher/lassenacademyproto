meta {
  name: GET - Verify Lesson in Watchlist
  type: http
  seq: 7
}

get {
  url: {{supabase_url}}/rest/v1/user_watchlist?item_type=eq.lesson&lesson_id=eq.{{test_lesson_id}}&select=item_type,lesson_id,user_id
  body: none
  auth: none
}

headers {
  apikey: {{supabase_anon_key}}
  Authorization: Bearer {{auth_token}}
}

assert {
  res.status: eq 200
  res.body: isArray
  res.body[0].item_type: eq lesson
}

script:post-response {
  const userId = bru.getVar("user_id");
  if (res.body[0].user_id !== userId) {
    throw new Error(`user_id mismatch: expected ${userId}, got ${res.body[0].user_id}`);
  }
}
