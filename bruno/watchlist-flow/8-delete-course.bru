meta {
  name: Remove Course from Watchlist
  type: http
  seq: 8
}

delete {
  url: {{supabase_url}}/rest/v1/user_watchlist?item_type=eq.course&course_id=eq.{{test_course_id}}
  body: none
  auth: none
}

headers {
  apikey: {{supabase_anon_key}}
  Authorization: Bearer {{auth_token}}
}

assert {
  res.status: eq 204
}
